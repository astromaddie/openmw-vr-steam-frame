diff --git a/components/vr/frameworld.hpp b/components/vr/frameworld.hpp
new file mode 100644
index 0000000..c663092
--- /dev/null
+++ b/components/vr/frameworld.hpp
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+namespace VR
+{
+    // Only the physical-to-game boundary uses this adapter. OpenXR poses,
+    // compositor submissions and physical combat velocity remain in metres.
+    inline float validWorldScale(float value)
+    {
+        return std::isfinite(value) ? std::clamp(value, 0.25f, 4.f) : 1.f;
+    }
+    inline float validHeightOffset(float value)
+    {
+        return std::isfinite(value) ? std::clamp(value, -1.f, 1.f) : 0.f;
+    }
+    inline float postureTranslation(float center, float offset, float scale)
+    {
+        return (-center + validHeightOffset(offset)) * validWorldScale(scale);
+    }
+    template <class Position>
+    Position physicalToWorld(Position position, float scale)
+    {
+        return position * validWorldScale(scale);
+    }
+
+    // Coordinates are relative to this session's LOCAL space, never persisted.
+    // A seated capture must not overwrite the retained standing center.
+    class PostureCalibration
+    {
+    public:
+        bool seated() const { return mSeated; }
+        bool hasStanding() const { return mStanding.has_value(); }
+        bool pending() const { return mCapture; }
+        float center() const { return mCenter; }
+        void setSeated(bool seated)
+        {
+            if (mSeated == seated) return;
+            mSeated = seated;
+            mCapture = seated;
+            if (!seated && mStanding) mCenter = *mStanding;
+            // Without a standing baseline, keep the current center until the
+            // user explicitly calibrates while standing. Never guess a height.
+        }
+        void requestCalibration() { mCapture = true; mAllowStanding = true; }
+        bool sample(float z, bool tracked)
+        {
+            if (!mCapture || !tracked || !std::isfinite(z)) return false;
+            mCenter = z;
+            if (!mSeated && mAllowStanding) mStanding = z;
+            mCapture = false;
+            return true;
+        }
+        void invalidate()
+        {
+            mStanding.reset();
+            mCenter = 0.f;
+            mCapture = true;
+            mAllowStanding = false; // safe current-pose fallback; explicit standing calibration required
+        }
+    private:
+        bool mSeated = false;
+        bool mCapture = true;
+        bool mAllowStanding = true;
+        float mCenter = 0.f;
+        std::optional<float> mStanding;
+    };
+}

index 0000000..47c1d24
--- /dev/null
+++ b/files/data/scripts/omw/vr/ui/framesettings.lua
@@ -0,0 +1,207 @@
+-- Native MWUI panel: all edits use the same settings/storage as gameplay.
+local vr = require('openmw.vr')
+if not vr.isVr() then return {} end
+local ui = require('openmw.ui')
+local util = require('openmw.util')
+local storage = require('openmw.storage')
+local input = require('openmw.input')
+local async = require('openmw.async')
+local I = require('openmw.interfaces')
+local controls = require('scripts.omw.vr.inputs.common').controlsSection
+local button = require('scripts.omw.vr.ui.button')
+local prefs = storage.playerSection('SettingsFrameVR')
+local spaces = storage.playerSection('SpacesGroup')
+local V2 = util.vector2
+local tabs = {'Comfort', 'Controls', 'HUD & Menus', 'Display', 'Accessibility', 'Room'}
+local activeTab, selected = 1, 1
+local panel, buttons, dirty = nil, {}, true
+local pointerFocus = nil
+local rebuild
+local function profile() return prefs:get('defaults_profile') or 'standard' end
+local function native(key) return vr._frameSettingGet(key) end
+local function setNative(key, v) vr._frameSettingSet(key, v); dirty = true end
+local function set(section, key, v) section:set(key, v); dirty = true end
+local function close() vr._closeFrameSettings() end
+local function turnDefaults()
+    controls:set('SmoothTurn', profile() == 'frame_personal')
+    controls:set('SmoothTurnSensitivity', math.rad(120))
+    controls:set('SnapTurnRate', 30)
+end
+local function defaults()
+    -- Tab-scoped defaults preserve other categories and unknown settings.
+    if activeTab == 1 then turnDefaults()
+    elseif activeTab == 2 then
+        for key, v in pairs({['haptics enabled']=1, ['left handed mode']=0, ['hand directed movement']=0}) do
+            vr._frameSettingSet(key, v)
+        end
+    elseif activeTab == 3 then
+        prefs:set('menu_scale', 1)
+        prefs:set('hud_scale', 1)
+        prefs:set('menu_distance', 1)
+        spaces:set('HUDSpace', 'LeftWristTop')
+    elseif activeTab == 5 then
+        vr._frameSettingSet('show 3D crosshairs', 1)
+        controls:set('PhysicalSneak', false)
+    end
+    dirty = true
+end
+local function number(section,key,fallback,lo,hi)
+    local v=section:get(key)
+    if type(v)~='number' or v~=v or math.abs(v)==math.huge then return fallback end
+    return math.max(lo,math.min(hi,v))
+end
+local function label(text, x, y, width, size)
+    return {template=I.MWUI.templates.textNormal, props={text=text, position=V2(x,y),
+        size=V2(width,40), textSize=size or 24}}
+end
+local function addButton(content, text, x, y, cb)
+    local n = #buttons + 1
+    local b = button((selected == n and '> ' or '') .. text, function() selected=n; cb(); dirty=true end)
+    b.alive=true
+    b.buttonContent[1].events.focusGain=async:callback(function()
+        if not b.alive then return end
+        pointerFocus=n
+        b.focused=true
+        b:update()
+        return true
+    end)
+    b.buttonContent[1].events.focusLoss=async:callback(function()
+        if not b.alive then return end
+        if pointerFocus==n then pointerFocus=nil end
+        b.focused=false
+        b:update()
+        return true
+    end)
+    b.textContent[1].props.textSize = y == 70 and 18 or 22
+    b.element.layout.props.position=V2(x,y)
+    b.element:update()
+    buttons[n]=b
+    content[#content+1]=b.element
+end
+local function row(content, y, text, shown, minus, plus)
+    content[#content+1]=label(text,24,y+4,360)
+    content[#content+1]=label(shown,390,y+4,230)
+    addButton(content,'- ',650,y,minus)
+    addButton(content,'+ ',740,y,plus)
+end
+local function toggle(content,y,text,shown,cb)
+    content[#content+1]=label(text,24,y+4,360)
+    addButton(content,shown,390,y,cb)
+end
+local function nativeToggle(content,y,text,key,off,on)
+    toggle(content,y,text,native(key)~=0 and (on or 'On') or (off or 'Off'),
+        function() setNative(key,native(key)==0 and 1 or 0) end)
+end
+local function step(content,y,text,section,key,fallback,delta,lo,hi,format)
+    local v=number(section,key,fallback,lo,hi)
+    row(content,y,text,string.format(format or '%.2f',v),
+        function() set(section,key,math.max(lo,v-delta)) end,
+        function() set(section,key,math.min(hi,v+delta)) end)
+end
+rebuild=function()
+    for _,b in ipairs(buttons) do b.alive=false; b:cleanup() end
+    if panel then panel:destroy(); panel=nil end
+    buttons={}
+    pointerFocus=nil
+    local content={label('VR Settings',24,16,500,32)}
+    for n,name in ipairs(tabs) do
+        addButton(content,(n==activeTab and '['..name..']' or name),24+(n-1)*142,70,
+            function() activeTab=n; selected=n end)
+    end
+    local y=140
+    if activeTab==1 then
+        toggle(content,y,'Turning',controls:get('SmoothTurn') and 'Smooth' or 'Snap',
+            function() set(controls,'SmoothTurn',not controls:get('SmoothTurn')) end)
+        step(content,y+60,'Snap Angle',controls,'SnapTurnRate',30,15,15,90,'%.0f degrees')
+        local speed=number(controls,'SmoothTurnSensitivity',math.rad(120),math.rad(30),math.rad(240))
+        row(content,y+120,'Smooth Speed',string.format('%.0f degrees / s',math.deg(speed)),
+            function() set(controls,'SmoothTurnSensitivity',math.max(math.rad(30),speed-math.rad(15))) end,
+            function() set(controls,'SmoothTurnSensitivity',math.min(math.rad(240),speed+math.rad(15))) end)
+        content[#content+1]=label('Snap is the distributed default. Personal uses smooth 120.',24,y+200,820,20)
+    elseif activeTab==2 then
+        nativeToggle(content,y,'Dominant Hand','left handed mode','Right','Left')
+        nativeToggle(content,y+60,'Movement Direction','hand directed movement','Head','Hand')
+        nativeToggle(content,y+120,'Controller Haptics','haptics enabled')
+        content[#content+1]=label('Physical Menu and View retain their system roles.',24,y+200,820,20)
+    elseif activeTab==3 then
+        step(content,y,'Menu Scale',prefs,'menu_scale',1,0.1,0.7,1.5,'%.1f x')
+        step(content,y+60,'HUD Scale',prefs,'hud_scale',1,0.1,0.7,1.5,'%.1f x')
+        step(content,y+120,'Menu Distance',prefs,'menu_distance',1,0.1,0.6,2,'%.1f m')
+        local positions={'LeftWristTop','RightWristTop','HUDTopLeft','HUDTopRight','HUDBottomLeft','HUDBottomRight'}
+        local current=spaces:get('HUDSpace') or positions[1]
+        toggle(content,y+180,'HUD Location',current,function()
+            local index=1
+            for n,p in ipairs(positions) do if p==current then index=n%#positions+1 end end
+            set(spaces,'HUDSpace',positions[index])
+        end)
+    elseif activeTab==4 then
+        content[#content+1]=label('Graphics options use OpenMW\'s existing settings window.',24,y,820,22)
+        addButton(content,'Open Graphics Settings',24,y+65,function() vr._frameOpenOptions() end)
+        content[#content+1]=label('Eye resolution is configured at startup.',24,y+140,820,22)
+    elseif activeTab==5 then
+        nativeToggle(content,y,'3D Crosshairs','show 3D crosshairs')
+        toggle(content,y+60,'Physical Sneak',controls:get('PhysicalSneak') and 'On' or 'Off',
+            function() set(controls,'PhysicalSneak',not controls:get('PhysicalSneak')) end)
+        addButton(content,'Open Audio Settings',24,y+130,function() vr._frameOpenOptions() end)
+    elseif activeTab==6 then
+        addButton(content,'Recenter',24,y,function() vr._recenterXY() end)
+        addButton(content,'Calibrate Height',260,y,function() vr._recenterXY(); vr._recenterZ() end)
+        content[#content+1]=label('Calibrate in your seated or standing playing position.',24,y+90,820,22)
+        content[#content+1]=label('Recenter preserves height; calibration resets the vertical origin.',24,y+140,820,22)
+    end
+    addButton(content,profile()=='frame_personal' and 'Profile: Personal' or 'Profile: Standard',24,455,function()
+        prefs:set('defaults_profile',profile()=='standard' and 'frame_personal' or 'standard')
+        turnDefaults()
+    end)
+    if activeTab ~= 4 and activeTab ~= 6 then addButton(content,'Tab Defaults',390,455,defaults) end
+    addButton(content,'Back',740,455,close)
+    content[#content+1]=label('Changes apply immediately and are saved.  D-pad: select   A: change   B: back',24,520,840,18)
+    panel=ui.create{template=I.MWUI.templates.boxSolidThick,layer='MainMenu',
+        props={relativePosition=V2(0.5,0.5),anchor=V2(0.5,0.5),size=V2(890,560)},content=ui.content(content)}
+    dirty=false
+end
+-- OpenXR triggers are distinct from SDL controller events. Keep the established
+-- PointerActivate hit-testing path; MenuSelect activates keyboard-style selection.
+local function navigate(delta)
+    if not panel then return end
+    selected=(selected-1+delta)%#buttons+1
+    dirty=true
+end
+local function registerTriggerHandlers()
+    for key,delta in pairs({MenuUp=-1,MenuLeft=-1,MenuDown=1,MenuRight=1}) do
+        if input.triggers[key] then
+            input.registerTriggerHandler(key,async:callback(function() navigate(delta) end))
+        end
+    end
+    if input.triggers.MenuSelect then
+        input.registerTriggerHandler('MenuSelect',async:callback(function()
+            if panel and not pointerFocus and buttons[selected] then buttons[selected].callback() end
+        end))
+    end
+    -- MenuBack already calls native WindowBase::exit(), which restores the origin.
+end
+registerTriggerHandlers()
+I.vrinputs.addMenuTriggersHeartBeatListener(registerTriggerHandlers)
+return {engineHandlers={
+    onFrame=function()
+        if not vr._frameSettingsActive() then
+            if panel then
+                for _,b in ipairs(buttons) do b.alive=false; b:cleanup() end
+                panel:destroy(); panel=nil; buttons={}
+            end
+            return
+        end
+        if not panel or dirty then rebuild() end
+    end,
+    onControllerButtonPress=function(id)
+        if not panel then return end
+        local b=input.CONTROLLER_BUTTON
+        if id==b.B or id==b.Back then close()
+        elseif id==b.DPadDown or id==b.DPadRight then selected=selected%#buttons+1; dirty=true
+        elseif id==b.DPadUp or id==b.DPadLeft then selected=(selected-2)%#buttons+1; dirty=true
+        elseif id==b.A and buttons[selected] then buttons[selected].callback() end
+    end,
+    onKeyPress=function(key)
+        if panel and key.code==input.KEY.Escape then close() end
+    end,
+}}

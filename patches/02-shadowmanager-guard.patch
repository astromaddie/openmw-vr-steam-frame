--- a/apps/openmw/mwvr/vrpointer.cpp
+++ b/apps/openmw/mwvr/vrpointer.cpp
@@ -342,7 +342,9 @@ namespace MWVR
         osg::ref_ptr<osg::LightModel> lightmodel = new osg::LightModel;
         lightmodel->setAmbientIntensity(osg::Vec4(1.0, 1.0, 1.0, 1.0));
         stateset->setAttributeAndModes(lightmodel, osg::StateAttribute::ON);
-        SceneUtil::ShadowManager::instance().disableShadowsForStateSet(*stateset);
+        // May run before the RenderingManager has created the ShadowManager
+        if (SceneUtil::ShadowManager::hasInstance())
+            SceneUtil::ShadowManager::instance().disableShadowsForStateSet(*stateset);
 
         osg::ref_ptr<osg::Material> material = new osg::Material;
         material->setColorMode(osg::Material::ColorMode::AMBIENT_AND_DIFFUSE);

The VR GUI and pointer set up their state sets before the RenderingManager creates the ShadowManager,
so ShadowManager::instance() throws "No ShadowManager exists yet" at startup. Only disable shadows
when a ShadowManager exists (the source already comments out a third call for the same reason).

diff --git a/apps/openmw/mwvr/vrgui.cpp b/apps/openmw/mwvr/vrgui.cpp
index 2bacdc4..b4878fd 100644
--- a/apps/openmw/mwvr/vrgui.cpp
+++ b/apps/openmw/mwvr/vrgui.cpp
@@ -747,7 +747,9 @@ namespace MWVR
         lightmodel->setAmbientIntensity(osg::Vec4(1.0, 1.0, 1.0, 1.0));
         stateset->setAttributeAndModes(lightmodel, osg::StateAttribute::ON);
 
-        SceneUtil::ShadowManager::instance().disableShadowsForStateSet(*stateset);
+        // May run before the RenderingManager has created the ShadowManager (see the GUI camera TODO above)
+        if (SceneUtil::ShadowManager::hasInstance())
+            SceneUtil::ShadowManager::instance().disableShadowsForStateSet(*stateset);
         mGeometries->setStateSet(stateset);
     }
 
diff --git a/apps/openmw/mwvr/vrpointer.cpp b/apps/openmw/mwvr/vrpointer.cpp

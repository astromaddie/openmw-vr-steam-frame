diff --git a/apps/openmw/mwvr/guipointer.hpp b/apps/openmw/mwvr/guipointer.hpp
new file mode 100644
index 0000000..bb59b8f
--- /dev/null
+++ b/apps/openmw/mwvr/guipointer.hpp
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "../mwrender/vismask.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace MWVR::Util
+{
+    inline float guiPointerScale(float scale)
+    {
+        return std::isfinite(scale) ? std::clamp(scale, .25f, 4.f) : 1.f;
+    }
+
+    inline float guiPointerReach(float scale, float unitsPerMeter)
+    {
+        // Maximum configured menu distance is 2 physical metres. Reserve one
+        // metre for the hand behind the head, panel tilt and lateral aiming.
+        return 3.f * unitsPerMeter * guiPointerScale(scale);
+    }
+
+    inline float pointerWidth(bool guiHit, float scale)
+    {
+        return .25f * (guiHit ? guiPointerScale(scale) : 1.f);
+    }
+
+    // Separate query results prevent a distant occluder from becoming an
+    // activatable world target. WorldCast retains the native gameplay range.
+    template <class Result, class GuiCast, class OcclusionCast, class WorldCast>
+    float targetWithGui(Result& result, bool guiMode, uint32_t ignoreMask,
+        float scale, float unitsPerMeter, GuiCast guiCast, OcclusionCast occlusionCast, WorldCast worldCast)
+    {
+        if (guiMode && !(ignoreMask & MWRender::Mask_3DGUI))
+        {
+            Result gui{};
+            const float distance = guiCast(gui, guiPointerReach(scale, unitsPerMeter));
+            if (gui.mHit)
+            {
+                Result occluder{};
+                const float occlusionDistance = occlusionCast(occluder, distance, ignoreMask | MWRender::Mask_3DGUI);
+                if (!occluder.mHit || occlusionDistance >= distance)
+                {
+                    result = gui;
+                    return distance;
+                }
+            }
+            // The GUI query already handled all selectable GUI. The fallback
+            // must not accidentally select one through an occluding wall.
+            return worldCast(result, ignoreMask | MWRender::Mask_3DGUI);
+        }
+        return worldCast(result, ignoreMask);
+    }
+}

+    float VRGUIManager::castPointerRay(MWRender::RayResult& result, const Stereo::Pose& pose, float maxDistance)
+    {
+        std::scoped_lock lock(mMutex);
+        result = {};
+        auto direction = pose.orientation * osg::Vec3f(0, 1, 0);
+        direction.normalize();
+        const auto origin = pose.position.asMWUnits();
+        osg::ref_ptr<osgUtil::LineSegmentIntersector> ray = new osgUtil::LineSegmentIntersector(
+            osgUtil::LineSegmentIntersector::MODEL, origin, origin + direction * maxDistance);
+        ray->setIntersectionLimit(osgUtil::LineSegmentIntersector::LIMIT_NEAREST);
+        osgUtil::IntersectionVisitor visitor(ray.get());
+        // This dedicated group contains world-positioned GUI transforms only;
+        // it excludes the sibling RTT camera and all world-object subtrees.
+        // Non-pickable layers have Mask_3DGUI_NonIntersectable, not Mask_3DGUI.
+        visitor.setTraversalMask(MWRender::Mask_3DGUI);
+        mGeometries->accept(visitor);
+        if (!ray->containsIntersections())
+            return 0.f;
+        const auto& hit = ray->getFirstIntersection();
+        auto* geometry = hit.drawable.get();
+        if (!geometry || !dynamic_cast<VRGUILayerUserData*>(geometry->getUserData()))
+            return 0.f;
+        result.mHit = true;
+        result.mHitNode = geometry;
+        result.mHitPointWorld = hit.getWorldIntersectPoint();
+        result.mHitNormalWorld = hit.getWorldIntersectNormal();
+        result.mHitPointLocal = hit.getLocalIntersectPoint();
+        result.mRatio = static_cast<float>(hit.ratio);
+        return result.mRatio * maxDistance;
+    }

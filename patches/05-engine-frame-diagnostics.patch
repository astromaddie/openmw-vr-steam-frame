+    void Viewer::captureDiagnosticEye(osg::State* state, osg::FrameBufferObject* framebuffer, int eye)
+    {
+        mDiagnosticEyeCaptureAttempted[eye] = true;
+        const char* eyeName = eye == VR::Side_Left ? "left" : "right";
+        try
+        {
+            std::filesystem::create_directories(mDiagnosticCaptureDirectory);
+            framebuffer->apply(*state, osg::FrameBufferObject::READ_FRAMEBUFFER);
+            auto* gl = osg::GLExtensions::Get(state->getContextID(), false);
+            if (gl)
+                gl->glReadBuffer(GL_COLOR_ATTACHMENT0);
+
+            osg::ref_ptr<osg::Image> image = new osg::Image;
+            image->readPixels(static_cast<int>(mSubImages[eye].x), static_cast<int>(mSubImages[eye].y),
+                static_cast<int>(mSubImages[eye].width), static_cast<int>(mSubImages[eye].height), GL_RGBA,
+                GL_UNSIGNED_BYTE);
+            image->flipVertical();
+
+            const auto fileName = "openmw-frame-diagnostic-synthetic-" + mDiagnosticCaptureSessionId + "-frame-"
+                + std::to_string(mDrawFrame.frameNumber) + "-" + eyeName + ".png";
+            const auto outputPath = mDiagnosticCaptureDirectory / fileName;
+            if (!osgDB::writeImageFile(*image, outputPath.string()))

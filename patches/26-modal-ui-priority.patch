diff --git a/apps/openmw/mwvr/guirender.hpp b/apps/openmw/mwvr/guirender.hpp
new file mode 100644
--- /dev/null
+++ b/apps/openmw/mwvr/guirender.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "../mwrender/renderbin.hpp"
+
+#include <osg/Depth>
+#include <osg/StateSet>
+#include <osgUtil/RenderBin>
+
+#include <string_view>
+
+namespace MWVR
+{
+    inline bool guiOverlayRequired(bool guiMode, std::string_view layer)
+    {
+        // WindowManager::isGuiMode also includes interactive message boxes,
+        // console and chargen. Timed tutorial messages use Notification without
+        // entering GUI mode. Leave gameplay HUD layers at their native depth.
+        return guiMode || layer == "Notification";
+    }
+
+    inline osg::ref_ptr<osg::StateSet> createGuiOverlayState(bool pointer = false)
+    {
+        // Do not reuse DepthSortedBin: the postprocessor installs a transparent
+        // depth postpass on that prototype. UI must never populate world depth.
+        static const bool registered = [] {
+            osgUtil::RenderBin::addRenderBinPrototype(
+                "VRGUI", new osgUtil::RenderBin(osgUtil::RenderBin::SORT_BACK_TO_FRONT));
+            return true;
+        }();
+        (void)registered;
+
+        osg::ref_ptr<osg::StateSet> state = new osg::StateSet;
+        constexpr auto protectedOverride = osg::StateAttribute::PROTECTED | osg::StateAttribute::OVERRIDE;
+        state->setAttributeAndModes(new osg::Depth(osg::Depth::ALWAYS, 0.0, 1.0, false),
+            osg::StateAttribute::OFF | protectedOverride);
+        // Protected defeats inherited depth overrides; override prevents a
+        // drawable from silently restoring world depth beneath this policy.
+        state->setMode(GL_DEPTH_TEST, osg::StateAttribute::OFF | protectedOverride);
+        state->setRenderBinDetails(pointer ? MWRender::RenderBin_VRGUIPointer : MWRender::RenderBin_VRGUI,
+            "VRGUI", osg::StateSet::OVERRIDE_PROTECTED_RENDERBIN_DETAILS);
+        state->setNestRenderBins(false);
+        return state;
+    }
+}

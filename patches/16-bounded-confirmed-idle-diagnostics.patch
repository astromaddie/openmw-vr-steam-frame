diff --git a/components/xr/diagnosticguard.hpp b/components/xr/diagnosticguard.hpp
new file mode 100644
--- /dev/null
+++ b/components/xr/diagnosticguard.hpp
@@ -0,0 +1,17 @@
+#pragma once
+#include <cmath>
+#include <cstdlib>
+#include <string_view>
+
+namespace XR
+{
+    // Explicitly confirmed idle diagnostics stay offscreen, input-free and bounded.
+    inline bool boundedConfirmedIdleDiagnostic(const char* confirmation, const char* duration)
+    {
+        if (!confirmation || std::string_view(confirmation) != "1" || !duration || !*duration)
+            return false;
+        char* end = nullptr;
+        const double seconds = std::strtod(duration, &end);
+        return end != duration && *end == '\0' && std::isfinite(seconds) && seconds > 0.0 && seconds <= 60.0;
+    }
+}

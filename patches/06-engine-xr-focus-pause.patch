diff --git a/apps/openmw/mwvr/focuspause.hpp b/apps/openmw/mwvr/focuspause.hpp
new file mode 100644
index 0000000..3900aeb
--- /dev/null
+++ b/apps/openmw/mwvr/focuspause.hpp
@@ -0,0 +1,33 @@
+#ifndef OPENMW_MWVR_FOCUSPAUSE_H
+#define OPENMW_MWVR_FOCUSPAUSE_H
+
+namespace MWVR
+{
+    class FocusPauseController
+    {
+    public:
+        enum class Transition
+        {
+            None,
+            Pause,
+            Resume
+        };
+
+        Transition update(bool hasXrSession, bool diagnosticMode, bool focused)
+        {
+            const bool shouldPause = hasXrSession && !diagnosticMode && !focused;
+            if (shouldPause == mPaused)
+                return Transition::None;
+
+            mPaused = shouldPause;
+            return mPaused ? Transition::Pause : Transition::Resume;
+        }
+
+        bool isPaused() const { return mPaused; }
+
+    private:
+        bool mPaused = false;
+    };
+}
+
+#endif
